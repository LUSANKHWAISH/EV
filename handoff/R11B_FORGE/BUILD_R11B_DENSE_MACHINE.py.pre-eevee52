# E.V. R11B VECTOR REACTOR — DENSE MACHINE REVISION
# Generated by ChatGPT.
# Blender 5.2 compatible target.
# Builds/exports/renders ONLY in this handoff folder. It never touches D:\EV\gui.
#
# Run:
#   "C:\Program Files\Blender Foundation\Blender 5.2\blender.exe" --background --python BUILD_R11B_DENSE_MACHINE.py

import bpy
import math
import os
from mathutils import Vector

HERE = os.path.dirname(os.path.abspath(__file__))
OUT = os.path.join(HERE, "output")
RENDERS = os.path.join(OUT, "renders")
ASSETS = os.path.join(OUT, "assets")
os.makedirs(RENDERS, exist_ok=True)
os.makedirs(ASSETS, exist_ok=True)

# -----------------------------------------------------------------------------
# RESET / RENDER
# -----------------------------------------------------------------------------

bpy.ops.object.select_all(action="SELECT")
bpy.ops.object.delete(use_global=False)

scene = bpy.context.scene
scene.render.resolution_x = 1600
scene.render.resolution_y = 1000
scene.render.resolution_percentage = 100
scene.render.image_settings.file_format = "PNG"
scene.render.film_transparent = False
scene.render.engine = "BLENDER_EEVEE_NEXT"

world = bpy.data.worlds.get("World") or bpy.data.worlds.new("World")
scene.world = world
world.use_nodes = True
bg = world.node_tree.nodes.get("Background")
bg.inputs["Color"].default_value = (0.0015, 0.003, 0.0065, 1.0)
bg.inputs["Strength"].default_value = 0.065

# -----------------------------------------------------------------------------
# COLLECTIONS
# -----------------------------------------------------------------------------

def coll(name):
    c = bpy.data.collections.get(name)
    if c is None:
        c = bpy.data.collections.new(name)
        scene.collection.children.link(c)
    return c

C_FRAME   = coll("R11B_FRAME")
C_STATOR  = coll("R11B_STATOR")
C_FLUX    = coll("R11B_FLUX")
C_COILS   = coll("R11B_COILS")
C_LENS    = coll("R11B_LENS")
C_BEZEL   = coll("R11B_BEZEL")
C_ENERGY  = coll("R11B_ENERGY")
C_NODES   = coll("R11B_NODES")

def move(obj, target):
    for c in list(obj.users_collection):
        c.objects.unlink(obj)
    target.objects.link(obj)

# -----------------------------------------------------------------------------
# MATERIALS
# -----------------------------------------------------------------------------

def principled(name, color, metallic, roughness):
    m = bpy.data.materials.new(name)
    m.use_nodes = True
    bsdf = m.node_tree.nodes.get("Principled BSDF")
    bsdf.inputs["Base Color"].default_value = (*color, 1.0)
    bsdf.inputs["Metallic"].default_value = metallic
    bsdf.inputs["Roughness"].default_value = roughness
    return m

def emission(name, color, strength):
    m = bpy.data.materials.new(name)
    m.use_nodes = True
    nt = m.node_tree
    nt.nodes.clear()
    out = nt.nodes.new("ShaderNodeOutputMaterial")
    em = nt.nodes.new("ShaderNodeEmission")
    em.inputs["Color"].default_value = (*color, 1.0)
    em.inputs["Strength"].default_value = strength
    nt.links.new(em.outputs["Emission"], out.inputs["Surface"])
    return m

def glass(name, color, rough=0.08, ior=1.46):
    m = bpy.data.materials.new(name)
    m.use_nodes = True
    nt = m.node_tree
    nt.nodes.clear()
    out = nt.nodes.new("ShaderNodeOutputMaterial")
    g = nt.nodes.new("ShaderNodeBsdfGlass")
    g.inputs["Color"].default_value = (*color, 1.0)
    g.inputs["Roughness"].default_value = rough
    g.inputs["IOR"].default_value = ior
    nt.links.new(g.outputs["BSDF"], out.inputs["Surface"])
    return m

M_GRAPHITE = principled("R11B_Graphite", (0.022,0.032,0.046), 0.82, 0.26)
M_GRAPHITE2 = principled("R11B_GraphiteSecondary", (0.048,0.066,0.090), 0.76, 0.31)
M_TITANIUM = principled("R11B_Titanium", (0.30,0.36,0.44), 0.90, 0.21)
M_SILVER = principled("R11B_PrecisionEdge", (0.54,0.61,0.69), 0.92, 0.17)
M_COPPER = principled("R11B_DarkCopper", (0.105,0.038,0.014), 0.78, 0.27)
M_CERAMIC = principled("R11B_BlackCeramic", (0.010,0.014,0.020), 0.22, 0.18)
M_GLASS = glass("R11B_SmokedLens", (0.040,0.090,0.140), 0.06)
M_ICE = emission("R11B_IceWhite", (0.60,0.86,1.00), 10.0)
M_CYAN = emission("R11B_CyanPlasma", (0.02,0.31,0.72), 4.6)
M_AMBER = emission("R11B_AmberMicro", (1.0,0.16,0.025), 2.3)

# -----------------------------------------------------------------------------
# BASIC GEOMETRY
# -----------------------------------------------------------------------------

def bevel(obj, width=0.05, seg=3):
    b = obj.modifiers.new("R11B_Bevel", "BEVEL")
    b.width = width
    b.segments = seg
    b.limit_method = "ANGLE"
    b.angle_limit = math.radians(18)

def weighted(obj):
    try:
        w = obj.modifiers.new("R11B_WeightedNormal", "WEIGHTED_NORMAL")
        w.keep_sharp = True
    except Exception:
        pass

def smooth(obj):
    if hasattr(obj.data, "polygons"):
        for p in obj.data.polygons:
            p.use_smooth = True

def cube(name, loc, size, mat, collection, rot=(0,0,0), bv=0.055):
    bpy.ops.mesh.primitive_cube_add(location=loc, rotation=rot)
    o = bpy.context.object
    o.name = name
    o.scale = (size[0]/2, size[1]/2, size[2]/2)
    bpy.ops.object.transform_apply(location=False, rotation=False, scale=True)
    o.data.materials.append(mat)
    bevel(o, min(bv, min(size)*0.18), 3)
    weighted(o)
    move(o, collection)
    return o

def cyl(name, radius, depth, loc, mat, collection, verts=96, rot=(0,0,0), bv=0.035):
    bpy.ops.mesh.primitive_cylinder_add(vertices=verts, radius=radius, depth=depth, location=loc, rotation=rot)
    o = bpy.context.object
    o.name = name
    o.data.materials.append(mat)
    bevel(o, bv, 3)
    weighted(o)
    smooth(o)
    move(o, collection)
    return o

def sphere(name, radius, loc, mat, collection, scale=(1,1,1), segments=64, rings=40):
    bpy.ops.mesh.primitive_uv_sphere_add(segments=segments, ring_count=rings, radius=radius, location=loc)
    o = bpy.context.object
    o.name = name
    o.scale = scale
    bpy.ops.object.transform_apply(location=False, rotation=False, scale=True)
    o.data.materials.append(mat)
    smooth(o)
    move(o, collection)
    return o

def torus(name, major, minor, loc, mat, collection, rot=(0,0,0), major_seg=96, minor_seg=24):
    bpy.ops.mesh.primitive_torus_add(
        major_radius=major,
        minor_radius=minor,
        major_segments=major_seg,
        minor_segments=minor_seg,
        location=loc,
        rotation=rot
    )
    o = bpy.context.object
    o.name = name
    o.data.materials.append(mat)
    smooth(o)
    move(o, collection)
    return o

def radial_box(name, angle_deg, radius, tangential, radial, depth, z, mat, collection,
               angle_bias=0.0, radial_bias=0.0):
    a = math.radians(angle_deg)
    r = radius + radial_bias
    loc = (r*math.cos(a), r*math.sin(a), z)
    return cube(
        name, loc, (tangential, radial, depth), mat, collection,
        rot=(0,0,a-math.pi/2+math.radians(angle_bias)),
        bv=min(0.07, min(tangential, radial, depth)*0.16)
    )

def polygon_beam(name, p1, p2, width, depth, z, mat, collection, bv=0.07):
    x1,y1 = p1
    x2,y2 = p2
    mx,my = (x1+x2)/2, (y1+y2)/2
    dx,dy = x2-x1, y2-y1
    length = math.hypot(dx,dy)
    angle = math.atan2(dy,dx)
    return cube(name, (mx,my,z), (length,width,depth), mat, collection,
                rot=(0,0,angle), bv=bv)

def ring_segment_mesh(name, r0, r1, a0, a1, depth, z, mat, collection, steps=48, bv=0.04):
    """Small/medium annular sectors only; never used to create a giant HUD ring."""
    A0, A1 = math.radians(a0), math.radians(a1)
    verts, faces = [], []
    for zz in (z-depth/2, z+depth/2):
        for i in range(steps+1):
            t=i/steps
            a=A0+(A1-A0)*t
            verts.append((r0*math.cos(a),r0*math.sin(a),zz))
            verts.append((r1*math.cos(a),r1*math.sin(a),zz))
    n=(steps+1)*2
    for i in range(steps):
        b=i*2; t=n+i*2
        faces.append((b,b+1,b+3,b+2))
        faces.append((t,t+2,t+3,t+1))
        faces.append((b,b+2,t+2,t))
        faces.append((b+1,t+1,t+3,b+3))
    faces.append((0,n,n+1,1))
    e=steps*2
    faces.append((e,e+1,n+e+1,n+e))
    me=bpy.data.meshes.new(name+"_mesh")
    me.from_pydata(verts,[],faces)
    me.update()
    o=bpy.data.objects.new(name,me)
    collection.objects.link(o)
    o.data.materials.append(mat)
    bevel(o,bv,3)
    weighted(o)
    smooth(o)
    return o

# -----------------------------------------------------------------------------
# DESIGN: MANUFACTURED OCTAGONAL REACTOR, NOT A HUD RING
# -----------------------------------------------------------------------------

# Slightly asymmetric outer envelope.
P = [
    ( 3.60,  3.95),  # NE
    (-0.45,  4.42),  # N
    (-3.95,  3.12),  # NW
    (-4.52, -0.30),  # W
    (-3.10, -3.78),  # SW
    ( 0.62, -4.18),  # S
    ( 4.08, -2.72),  # SE
    ( 4.44,  0.82),  # E
]

# Heavy frame beams, with deliberate gaps at ~2 and ~7 o'clock.
frame_edges = [(0,1),(1,2),(2,3),(3,4),(5,6),(6,7)]
for i,(a,b) in enumerate(frame_edges):
    thickness = [0.68,0.78,0.70,0.74,0.82,0.72][i]
    z = [0.02,0.14,-0.12,-0.20,0.34,0.08][i]
    polygon_beam(f"FrameBeam_{i}", P[a], P[b], thickness, 0.78, z, M_GRAPHITE, C_FRAME, 0.08)

# Frame corner armor blocks
for i,(x,y) in enumerate(P):
    if i in (4,):  # leave one structural gap exposed
        continue
    rot=math.atan2(y,x)-math.pi/2
    cube(f"FrameCorner_{i}", (x*0.93,y*0.93,0.15+(i%3)*0.08),
         (0.86,0.92,0.72), M_GRAPHITE2, C_FRAME, rot=(0,0,rot), bv=0.09)

# Precision channels on frame
for i,(a,b) in enumerate([(0,1),(1,2),(2,3),(5,6)]):
    p1,p2=P[a],P[b]
    x1,y1=p1; x2,y2=p2
    v=Vector((x2-x1,y2-y1))
    n=Vector((-v.y,v.x)).normalized()
    off=0.22
    q1=(x1+n.x*off,y1+n.y*off)
    q2=(x2+n.x*off,y2+n.y*off)
    polygon_beam(f"FrameEdgeLand_{i}", q1,q2,0.11,0.10,0.62, M_SILVER,C_FRAME,0.025)

# Rear stator: deep octagonal cage + radial structural ribs.
rear_scale=0.83
RP=[(x*rear_scale,y*rear_scale) for x,y in P]
for i in range(8):
    a=i; b=(i+1)%8
    if i==7:
        continue
    polygon_beam(f"RearCage_{i}", RP[a],RP[b],0.34,0.42,-1.78,M_GRAPHITE2,C_STATOR,0.05)

for i,a in enumerate([7,52,97,143,188,232,279,326]):
    radial_box(f"RearRib_{i}",a,3.25,0.18,1.36,0.28,-1.47,M_TITANIUM,C_STATOR,
               angle_bias=[-4,3,0,5,-3,2,-5,4][i])

# A deep rear plate, incomplete to keep silhouette open.
for i,(a0,a1) in enumerate([(10,42),(58,88),(107,139),(157,189),(207,239),(259,293),(316,345)]):
    ring_segment_mesh(f"RearPlate_{i}",2.55,3.12,a0,a1,0.26,-2.05,M_CERAMIC,C_STATOR,steps=34,bv=0.03)

# Flux cassettes — actual cartridge construction.
flux_angles=[12,56,101,147,194,239,285,331]
for i,a in enumerate(flux_angles):
    base_r=[3.12,3.08,3.16,3.05,3.18,3.10,3.22,3.04][i]
    z=[0.54,0.74,0.48,0.66,0.42,0.70,0.84,0.58][i]
    # Main cartridge housing
    radial_box(f"FluxHousing_{i}",a,base_r,0.62,1.12,0.68,z,M_GRAPHITE2,C_FLUX,
               angle_bias=[-5,4,-2,6,-4,2,-6,5][i])
    # Titanium face cap
    radial_box(f"FluxCap_{i}",a,base_r-0.26,0.48,0.44,0.11,z+0.40,M_TITANIUM,C_FLUX,
               angle_bias=[-5,4,-2,6,-4,2,-6,5][i])
    # Lower connector
    radial_box(f"FluxConnector_{i}",a,base_r+0.42,0.28,0.25,0.22,z-0.08,M_CERAMIC,C_FLUX,
               angle_bias=[-5,4,-2,6,-4,2,-6,5][i])
    # Micro energy seam, small only
    seam_mat=M_AMBER if i in (6,) else M_ICE
    radial_box(f"FluxSeam_{i}",a,base_r-0.48,0.34,0.055,0.035,z+0.50,seam_mat,C_ENERGY,
               angle_bias=[-5,4,-2,6,-4,2,-6,5][i])

    # Coil pack behind each cartridge: 4 dark-copper slats.
    for j in range(4):
        da=(-0.14 + j*0.093)
        aa=math.radians(a)
        tangent=Vector((-math.sin(aa),math.cos(aa)))
        center=Vector((base_r*math.cos(aa),base_r*math.sin(aa)))
        loc=center+tangent*da
        cube(f"Coil_{i}_{j}",(loc.x,loc.y,-0.72-j*0.018),
             (0.055,0.72,0.16),M_COPPER,C_COILS,rot=(0,0,aa),bv=0.012)

# Inner carrier / mounting brackets between cassettes and chamber.
for i,a in enumerate([34,79,124,171,216,262,308,351]):
    radial_box(f"InnerMount_{i}",a,2.24,0.24,0.78,0.32,-0.18,M_TITANIUM,C_STATOR,
               angle_bias=(i%3-1)*4)

# -----------------------------------------------------------------------------
# ENERGY CHAMBER: DEEP, DARK, MULTI-LAYER — NEVER A FLAT WHITE DISC
# -----------------------------------------------------------------------------

# Deep ceramic cavity behind everything.
cyl("ChamberRearCavity",1.72,0.72,(0,0,-1.65),M_CERAMIC,C_LENS,verts=128,bv=0.04)

# Rear containment ring
torus("ChamberRearConfinement",1.34,0.075,(0,0,-1.25),M_CYAN,C_LENS,major_seg=128,minor_seg=20)

# Smoked lens housing: eight short faceted retaining blocks around a circle.
for i,a in enumerate([0,45,90,135,180,225,270,315]):
    radial_box(f"LensRetainer_{i}",a,1.77,0.44,0.34,0.42,0.34,M_GRAPHITE,C_LENS,
               angle_bias=(i%2)*3-1.5)

# Titanium iris blades, separated and angled.
for i,a in enumerate([15,75,135,195,255,315]):
    radial_box(f"IrisBlade_{i}",a,1.36,0.28,0.62,0.18,0.66,M_TITANIUM,C_LENS,
               angle_bias=[7,-4,5,-6,4,-5][i])

# Smoked front lens — transparent but dark.
cyl("ContainmentGlass",1.24,0.16,(0,0,0.80),M_GLASS,C_LENS,verts=128,bv=0.02)

# White confinement field = thin torus, not a disc.
torus("ConfinementField",0.92,0.075,(0.02,-0.02,0.47),M_ICE,C_ENERGY,major_seg=128,minor_seg=20)

# Cyan plasma volume behind ring, deliberately smaller and deep.
sphere("PlasmaVolume",0.72,(0.02,-0.03,0.06),M_CYAN,C_LENS,scale=(1.0,1.0,0.58),segments=72,rings=44)

# Dark cognition nucleus dominates center silhouette.
sphere("CognitionNucleus",0.36,(-0.04,0.02,-0.42),M_CERAMIC,C_LENS,
       scale=(0.92,1.08,0.98),segments=64,rings=40)

# Rear pin-light deep inside chamber.
sphere("DeepPin",0.060,(0.14,-0.08,-0.93),M_ICE,C_ENERGY,segments=32,rings=20)

# Foreground precision bezel: only 5 segments.
for i,(a0,a1) in enumerate([(5,43),(63,101),(128,166),(205,244),(283,326)]):
    ring_segment_mesh(f"FrontBezel_{i}",1.92,2.08,a0,a1,0.18,1.13,M_SILVER,C_BEZEL,
                      steps=30,bv=0.022)

# Sparse internal emitter segments, never a complete ring.
for i,(a0,a1,mat,z) in enumerate([
    (18,37,M_ICE,0.88),
    (75,94,M_CYAN,0.76),
    (142,162,M_ICE,0.82),
    (220,238,M_CYAN,0.70),
    (302,316,M_AMBER,0.74),
]):
    ring_segment_mesh(f"Emitter_{i}",1.06,1.13,a0,a1,0.055,z,mat,C_ENERGY,steps=20,bv=0.012)

# Sparse cognition/sensing points, tucked into chamber depth.
for i,(a,r,z,sz) in enumerate([
    (25,0.66,0.77,0.035),(104,0.52,0.52,0.028),(178,0.76,0.31,0.030),
    (247,0.58,0.12,0.026),(322,0.68,0.40,0.028)
]):
    aa=math.radians(a)
    sphere(f"Node_{i}",sz,(r*math.cos(aa),r*math.sin(aa),z),M_ICE,C_NODES,segments=28,rings=18)

# -----------------------------------------------------------------------------
# LIGHTING
# -----------------------------------------------------------------------------

def look(obj,target=(0,0,-0.25)):
    obj.rotation_euler=(Vector(target)-obj.location).to_track_quat("-Z","Y").to_euler()

def area(name,loc,energy,color,size):
    d=bpy.data.lights.new(name,"AREA")
    d.energy=energy; d.color=color; d.shape="DISK"; d.size=size
    o=bpy.data.objects.new(name,d); scene.collection.objects.link(o); o.location=loc; look(o)
    return o

def point(name,loc,energy,color,size):
    d=bpy.data.lights.new(name,"POINT")
    d.energy=energy; d.color=color; d.shadow_soft_size=size
    o=bpy.data.objects.new(name,d); scene.collection.objects.link(o); o.location=loc
    return o

area("Key",(-5.0,-5.8,8.8),1050,(0.72,0.84,1.0),4.2)
area("Fill",(5.6,-3.5,3.2),360,(0.22,0.33,0.52),4.8)
area("Rim",(4.0,5.5,-2.8),1250,(0.66,0.82,1.0),3.4)
point("Internal",(0.0,0.0,1.1),210,(0.04,0.28,1.0),0.7)
point("CopperAccent",(3.2,-1.7,0.8),55,(1.0,0.12,0.02),0.5)

# -----------------------------------------------------------------------------
# CAMERA / APPROVAL RENDERS WITH BREATHING ROOM
# -----------------------------------------------------------------------------

cam_data=bpy.data.cameras.new("R11B_Camera")
cam=bpy.data.objects.new("R11B_Camera",cam_data)
scene.collection.objects.link(cam)
scene.camera=cam
cam.data.sensor_width=36

def render(name,loc,target=(0,0,-0.30),lens=72):
    cam.location=loc
    cam.data.lens=lens
    look(cam,target)
    scene.render.filepath=os.path.join(RENDERS,name)
    bpy.ops.render.render(write_still=True)

# Whole core should fit with ~12-15% breathing room.
render("R11B_FRONT.png",(0,-0.7,17.0),lens=72)
render("R11B_PRIMARY_3Q.png",(5.3,-5.5,15.0),target=(0,0,-0.35),lens=72)
render("R11B_OPPOSITE_3Q.png",(-5.4,5.0,14.6),target=(0,0,-0.50),lens=72)
render("R11B_SIDE_DEPTH.png",(12.5,-1.0,8.4),target=(0,0,-0.65),lens=75)

# Reduced external light render to prove geometry/materials survive without bloom.
saved={}
for o in scene.objects:
    if o.type=="LIGHT":
        saved[o.name]=o.data.energy
        if o.name in ("Key","Fill","Rim"):
            o.data.energy*=0.30
        elif o.name=="Internal":
            o.data.energy*=1.35
render("R11B_DARK_ENERGY.png",(5.3,-5.5,15.0),target=(0,0,-0.35),lens=72)
for o in scene.objects:
    if o.type=="LIGHT" and o.name in saved:
        o.data.energy=saved[o.name]

# -----------------------------------------------------------------------------
# SAVE / EXPORT
# -----------------------------------------------------------------------------

blend=os.path.join(OUT,"R11B_VECTOR_REACTOR_SOURCE.blend")
bpy.ops.wm.save_as_mainfile(filepath=blend)

def export_collection(collection,filename):
    bpy.ops.object.select_all(action="DESELECT")
    selectable=[o for o in collection.all_objects if o.type in {"MESH","EMPTY"}]
    for o in selectable: o.select_set(True)
    if not selectable: return
    bpy.context.view_layer.objects.active=selectable[0]
    bpy.ops.export_scene.gltf(
        filepath=os.path.join(ASSETS,filename),
        export_format="GLB",
        use_selection=True,
        export_apply=True,
        export_yup=True
    )

exports=[
    (C_FRAME,"ev_core_r11b_frame.glb"),
    (C_STATOR,"ev_core_r11b_stator.glb"),
    (C_FLUX,"ev_core_r11b_flux.glb"),
    (C_COILS,"ev_core_r11b_coils.glb"),
    (C_LENS,"ev_core_r11b_lens.glb"),
    (C_BEZEL,"ev_core_r11b_bezel.glb"),
    (C_ENERGY,"ev_core_r11b_energy.glb"),
    (C_NODES,"ev_core_r11b_nodes.glb"),
]
for c,f in exports: export_collection(c,f)

# Triangle count after modifiers.
dg=bpy.context.evaluated_depsgraph_get()
tris=0
for o in scene.objects:
    if o.type=="MESH":
        ev=o.evaluated_get(dg); me=ev.to_mesh(); me.calc_loop_triangles()
        tris+=len(me.loop_triangles); ev.to_mesh_clear()

report=os.path.join(OUT,"R11B_BUILD_REPORT.txt")
with open(report,"w",encoding="utf-8") as f:
    f.write("E.V. R11B DENSE MACHINE BUILD REPORT\n")
    f.write("===================================\n\n")
    f.write(f"Blender: {bpy.app.version_string}\n")
    f.write(f"Evaluated triangles: {tris}\n")
    f.write("Live E.V. GUI modified: NO\n")
    f.write("Design intent: dense manufactured reactor; no flat white center; no giant HUD ring.\n\n")
    f.write("Approval renders:\n")
    for n in ["R11B_FRONT.png","R11B_PRIMARY_3Q.png","R11B_OPPOSITE_3Q.png",
              "R11B_SIDE_DEPTH.png","R11B_DARK_ENERGY.png"]:
        f.write("- "+os.path.join(RENDERS,n)+"\n")
    f.write("\nAssets:\n")
    for _,n in exports:
        p=os.path.join(ASSETS,n)
        f.write(f"- {p} ({os.path.getsize(p) if os.path.exists(p) else 0} bytes)\n")

print("\nR11B DENSE MACHINE COMPLETE")
print("Blend:",blend)
print("Triangle count:",tris)
print("Renders:",RENDERS)
print("Assets:",ASSETS)
print("Report:",report)
